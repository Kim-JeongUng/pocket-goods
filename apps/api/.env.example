# Preferred production auth: Gemini on Vertex AI.
GCP_LOCATION=global
GCP_PROJECT_ID=
GOOGLE_CREDENTIALS=

# Optional local/dev fallback for the Gemini Developer API.
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Order notification email.
RESEND_API_KEY=
# Test-only sender. For production, replace with a sender at your verified Resend domain.
ORDER_EMAIL_FROM=onboarding@resend.dev
ORDER_EMAIL_REPLY_TO=pocketgoods0000@gmail.com
ORDER_EMAIL_TO=kju7859@gmail.com

# Keep unset/false in production; when true the API can accept orders without sending email.
ORDER_EMAIL_ALLOW_SKIP=0
# Keep true in production so failed email delivery fails the order request visibly.
ORDER_EMAIL_REQUIRED=1
